---
import { getCollection, render, getEntries } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Prose from "../../components/Prose.astro";
import Calendar from "lucide-astro/Calendar";
import Clock from "lucide-astro/Clock";
import MapPin from "lucide-astro/MapPin";
import User from "lucide-astro/User";
import Video from "lucide-astro/Video";

export async function getStaticPaths() {
	const eventos = await getCollection("eventos");
	return eventos.map((evento) => ({
		params: { id: evento.id },
		props: { evento },
	}));
}

const { evento } = Astro.props;
const authors = evento.data.authors
	? await getEntries(evento.data.authors)
	: [];
const { Content } = await render(evento);
---

<PageLayout
  title={`GPUL - ${evento.data.title}`}
  description='Evento de GPUL'
  image={`media/eventos/${evento.id}.png`}
>
  <div
    class="mx-auto mt-8 max-w-prose px-4 sm:mt-12 sm:px-0 dark:text-white"
    id="event-body"
  >
    <h1 class="text-[1.9375rem] font-semibold leading-[2.25rem] tracking-tight text-balance dark:text-white sm:text-[2.5rem] sm:leading-[2.875rem]" transition:name={`title-${evento.data.title}`}>{evento.data.title}</h1>
    <p class="mt-2 text-xl leading-[1.5625rem] text-gray-600 text-pretty dark:text-neutral-300 sm:text-[1.4375rem] sm:leading-[1.875rem]">
      {evento.data.excerpt}
    </p>
    {
      evento.data.tags.length > 0 && (
        <div class="mt-2 mb-4 flex flex-wrap gap-2">
          {evento.data.tags.map((tag) => (
            <span transition:name={`tag-${evento.data.title}-${tag}`} class="rounded-full bg-orange-100 px-2 py-1 text-xs font-semibold text-orange-800 dark:bg-orange-300 dark:text-orange-800">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="my-8 sm:my-10">
      <img
        height="200px"
        src={"/media/eventos/"+evento.id+".png"}
        alt="Póster do evento"
        class="aspect-video w-full rounded-2xl object-cover"
        transition:name={`img-${evento.data.title}`}
      />
    </div>

    <div class="rounded-md border border-orange-500 bg-orange-100 p-4 dark:bg-orange-950">
      <ul class="space-y-2">
        {evento.data.date && <>
          <li class="flex items-start gap-2"><Calendar class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" /><span><b>Data:</b> {evento.data.date.toLocaleDateString("es-ES")}</span></li>
          <li class="flex items-start gap-2"><Clock class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" /><span><b>Hora:</b> {evento.data.date.getHours()+evento.data.date.getTimezoneOffset()/60}:{("0"+evento.data.date.getMinutes()).slice(-2)}</span></li>
        </>}
        {evento.data.location && <li class="flex items-start gap-2"><MapPin class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" /><span><b>Lugar:</b> {evento.data.location}</span></li>}
        {evento.data.authors && <li class="flex items-start gap-2"><User class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" /><span><b>Relatores:</b>{authors.map((author,idx) => <span> {author.data.portfolio && <a class="text-orange-800 underline decoration-1 underline-offset-2 hover:decoration-2 dark:text-orange-400" href={author.data.portfolio} target="_blank">{author.data.name}</a>||<span>{author.data.name}</span>}{idx < authors.length - 1 && ", "}</span>)}</span></li>}
        {evento.data.video && <li class="flex items-start gap-2"><Video class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" /><span><b>Vídeo:</b> <a href={evento.data.video} class="text-orange-800 underline decoration-1 underline-offset-2 hover:decoration-2 dark:text-orange-400" target="_blank">Gravación da charla</a></span></li>}
      </ul>
    </div>
    <Prose>
      <Content />
    </Prose>
  </div>
</PageLayout>
