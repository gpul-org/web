---
// TODO: TS wizardry for this pls 👉👈
const {
  contents,
  card,
  threeColumns = false,
  prioritizeFirstImage = false,
} = Astro.props;
const Card = card;
const contentLayout = threeColumns
  ? "grid grid-cols-1 gap-8 pb-4 justify-items-center md:grid-cols-2 lg:grid-cols-3"
  : "flex flex-wrap gap-8 place-content-center justify-items-center pb-4";
---

<section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <slot name="title" />
    </div>

    <div class={contentLayout}>
      {
        contents.length > 0 ? (
          contents.map((content: any, index: number) => (
            <Card
              content={content}
              priority={prioritizeFirstImage && index === 0}
            />
          ))
        ) : (
          <p class="col-span-full w-full text-center text-2xl text-gray-700 dark:text-neutral-300">
            <i>Parece que non hai moito por aquí agora mesmo</i>
            <br />
            <i>Seguro que pronto prepararemos máis actividades!</i>
          </p>
        )
      }
    </div>
  </div>
</section>
