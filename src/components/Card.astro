---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import ChevronRight from "lucide-astro/ChevronRight";

interface Props {
  class?: string;
  title: string;
  excerpt?: string;
  date?: Date;
  author?: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tags?: string[];
}

const {
  class: className = "",
  title,
  excerpt,
  date,
  author,
  href,
  image,
  imageAlt = title,
  tags = [],
} = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("gl", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
  }).format(date);
};

const CardTag = href ? "a" : "div";
---

<CardTag
  href={href}
  class={`w-full max-w-sm h-full p-3 bg-white block dark:bg-neutral-800 rounded-lg shadow-md overflow-hidden
          transition-transform duration-200 hover:scale-102
          hover:shadow-lg ${href == "a" ? "cursor-pointer" : ""} ${className}`}
  data-filtrable={tags.join(" ")}
>
  {
    image ? (
      <Image
        src={image}
        alt={imageAlt}
        width={640}
        height={360}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) calc(50vw - 2.5rem), calc(100vw - 2rem)"
        layout="constrained"
        fit="cover"
        position="center"
        class="w-full aspect-video rounded-lg object-cover"
        loading="lazy"
        transition:name={`img-${title}`}
      />
    ) : (
      <ImagePlaceholder
        height="200px"
        alt={imageAlt}
        className="aspect-video rounded-lg"
        transition:name={`img-${title}`}
      />
    )
  }

  <div class="p-6">
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-3">
          {tags.map((tag) => (
            <span
              transition:name={`tag-${title}-${tag}`}
              class="px-2 py-1 bg-orange-100 text-orange-800 dark:bg-orange-300 dark:text-orange-800 text-xs font-semibold rounded-full"
            >
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <h3
      class="text-xl font-semibold text-gray-900 dark:text-white mb-3 line-clamp-2 h-13"
      transition:name={`title-${title}`}
    >
      {title}
    </h3>

    {
      excerpt && (
        <p class="text-gray-600 dark:text-neutral-400 mb-4 line-clamp-3 h-18">
          {excerpt}
        </p>
      )
    }

    <div
      class="flex items-center justify-between text-sm text-gray-500 dark:text-neutral-300"
    >
      <div class="flex items-center space-x-4">
        {author && <span class="font-medium">{author}</span>}
        {date && <time datetime={date.toString()}>{formatDate(date)}</time>}
      </div>

      {
        href && (
          <span class="text-orange-700 dark:text-orange-500 font-medium flex items-center">
            Ler máis
            <ChevronRight class="ml-1 w-4 h-4" />
          </span>
        )
      }
    </div>
  </div>
</CardTag>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
