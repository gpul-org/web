---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import ChevronRight from "lucide-astro/ChevronRight";

interface Props {
	class?: string;
	title: string;
	excerpt?: string;
	date?: Date;
	author?: string;
	href?: string;
	transitionId: string;
	image?: ImageMetadata;
	imageAlt?: string;
	tags?: string[];
	priority?: boolean;
}

const {
	class: className = "",
	title,
	excerpt,
	date,
	author,
	href,
	transitionId,
	image,
	imageAlt = title,
	tags = [],
	priority = false,
} = Astro.props;

const formatDate = (date: Date) => {
	return new Intl.DateTimeFormat("gl", {
		year: "numeric",
		month: "numeric",
		day: "numeric",
	}).format(date);
};

const CardTag = href ? "a" : "div";
---

<CardTag
  href={href}
  aria-label={href ? `Ler máis sobre ${title}` : undefined}
  class={`group flex h-full w-full max-w-sm flex-col overflow-hidden rounded-2xl bg-white p-3 shadow-md dark:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-700 dark:focus-visible:outline-orange-400 motion-safe:transition-[transform,box-shadow] motion-safe:duration-150 motion-safe:ease-[cubic-bezier(0.2,0,0,1)] motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-lg ${className}`}
  data-filtrable={tags.join(" ")}
>
  {
    image ? (
      <Image
        src={image}
        alt={imageAlt}
        width={640}
        height={360}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) calc(50vw - 2.5rem), calc(100vw - 3.5rem)"
        layout="constrained"
        fit="cover"
        position="center"
        class="block w-full aspect-video rounded-lg object-cover outline outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10"
        priority={priority}
        loading={priority ? undefined : "lazy"}
        transition:name={`img-${transitionId}`}
      />
    ) : (
      <ImagePlaceholder
        height="200px"
        alt={imageAlt}
        className="aspect-video rounded-lg"
        transition:name={`img-${transitionId}`}
      />
    )
  }

  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-5">
    {
      tags.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span
              transition:name={`tag-${transitionId}-${tag}`}
              class="rounded-full bg-orange-100 px-2 py-1 text-xs font-semibold text-orange-800 dark:bg-orange-300 dark:text-orange-900"
            >
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <h3
      class="mb-3 min-h-[3.5rem] text-xl font-semibold leading-7 text-gray-900 line-clamp-2 text-balance dark:text-white"
      transition:name={`title-${transitionId}`}
    >
      {title}
    </h3>

    {
      excerpt && (
        <p class="mb-5 min-h-[4.5rem] text-base leading-6 text-gray-600 line-clamp-3 wrap-break-word text-pretty dark:text-neutral-400">
          {excerpt}
        </p>
      )
    }

    <div
      class="mt-auto grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-end gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-neutral-300"
    >
      <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
        {author && <span class="min-w-0 max-w-full break-words font-medium">{author}</span>}
        {date && (
          <time class="shrink-0 whitespace-nowrap tabular-nums" datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
        )}
      </div>

      {
        href && (
          <span class="inline-flex min-h-10 shrink-0 items-center whitespace-nowrap font-medium text-orange-700 dark:text-orange-500">
            Ler máis
            <ChevronRight aria-hidden="true" class="ml-1 h-4 w-4" />
          </span>
        )
      }
    </div>
  </div>
</CardTag>
