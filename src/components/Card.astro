---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import ChevronRight from "lucide-astro/ChevronRight";

interface Props {
  class?: string;
  title: string;
  excerpt?: string;
  date?: Date;
  author?: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tags?: string[];
}

const {
  class: className = "",
  title,
  excerpt,
  date,
  author,
  href,
  image,
  imageAlt = title,
  tags = [],
} = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("gl", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
  }).format(date);
};

const CardTag = href ? "a" : "div";
---

<CardTag
  href={href}
  aria-label={href ? `Ler máis sobre ${title}` : undefined}
  class={`card-link group flex h-full w-full max-w-sm flex-col overflow-hidden rounded-2xl bg-white p-3 shadow-md dark:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-700 dark:focus-visible:outline-orange-400 ${className}`}
  data-filtrable={tags.join(" ")}
>
  {
    image ? (
      <Image
        src={image}
        alt={imageAlt}
        width={640}
        height={360}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) calc(50vw - 2.5rem), calc(100vw - 3.5rem)"
        layout="constrained"
        fit="cover"
        position="center"
        class="card-image block w-full aspect-video rounded-lg object-cover"
        loading="lazy"
        transition:name={`img-${title}`}
      />
    ) : (
      <ImagePlaceholder
        height="200px"
        alt={imageAlt}
        className="aspect-video rounded-lg"
        transition:name={`img-${title}`}
      />
    )
  }

  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-5">
    {
      tags.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span
              transition:name={`tag-${title}-${tag}`}
              class="rounded-full bg-orange-100 px-2 py-1 text-xs font-semibold text-orange-800 dark:bg-orange-300 dark:text-orange-900"
            >
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <h3
      class="card-title mb-3 min-h-[3.5rem] text-xl font-semibold leading-7 text-gray-900 line-clamp-2 dark:text-white"
      transition:name={`title-${title}`}
    >
      {title}
    </h3>

    {
      excerpt && (
        <p class="card-excerpt mb-5 min-h-[4.5rem] text-base leading-6 text-gray-600 line-clamp-3 dark:text-neutral-400">
          {excerpt}
        </p>
      )
    }

    <div
      class="mt-auto grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-end gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-neutral-300"
    >
      <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
        {author && <span class="min-w-0 max-w-full break-words font-medium">{author}</span>}
        {date && (
          <time class="shrink-0 whitespace-nowrap tabular-nums" datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
        )}
      </div>

      {
        href && (
          <span class="inline-flex min-h-10 shrink-0 items-center whitespace-nowrap font-medium text-orange-700 dark:text-orange-500">
            Ler máis
            <ChevronRight aria-hidden="true" class="ml-1 h-4 w-4" />
          </span>
        )
      }
    </div>
  </div>
</CardTag>

<style>
  .card-link {
    transition:
      transform 150ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
  }

  .card-image {
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }

  .card-title {
    text-wrap: balance;
  }

  .card-excerpt {
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card-link:hover {
      transform: translateY(-2px);
      box-shadow:
        0 10px 15px -3px rgb(0 0 0 / 0.1),
        0 4px 6px -4px rgb(0 0 0 / 0.1);
    }
  }

  @media (prefers-color-scheme: dark) {
    .card-image {
      outline-color: oklch(1 0 0 / 0.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link {
      transition: none;
    }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
