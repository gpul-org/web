---
import { Vimeo, YouTube } from "astro-embed";

interface Props {
	url: string;
	title?: string;
}

const { url, title } = Astro.props;

type VideoProvider = "youtube" | "vimeo";

function getVideoProvider(videoUrl: string): VideoProvider | undefined {
	let parsedUrl: URL;

	try {
		parsedUrl = new URL(videoUrl);
	} catch {
		return undefined;
	}

	if (parsedUrl.protocol !== "http:" && parsedUrl.protocol !== "https:") {
		return undefined;
	}

	switch (parsedUrl.hostname.toLowerCase()) {
		case "youtube.com":
		case "www.youtube.com":
		case "youtu.be":
			return "youtube";
		case "vimeo.com":
		case "www.vimeo.com":
			return "vimeo";
		default:
			return undefined;
	}
}

const provider = getVideoProvider(url);
---

{
	provider === "youtube" && (
		<div class="mt-10 overflow-hidden rounded-2xl">
			<YouTube id={url} title={title} playlabel="Reproducir vídeo" />
		</div>
	)
}
{
	provider === "vimeo" && (
		<div class="mt-10 overflow-hidden rounded-2xl">
			<Vimeo id={url} playlabel="Reproducir vídeo" />
		</div>
	)
}
