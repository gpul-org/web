---
import type { Nova } from "../content/nova-data.ts";
import Card from "../components/Card.astro";

interface Props {
  content: Nova;
  class?: string;
  priority?: boolean;
}
const { content, class: className = "", priority = false } = Astro.props;
---

<Card
  class={className}
  title={content.data.title}
  transitionId={`nova-${content.id}`}
  excerpt={content.data.excerpt}
  date={content.data.date}
  image={content.data.image}
  author={content.data.author}
  href={`/novas/${content.id}`}
  tags={content.data.tags}
  priority={priority}
/>
