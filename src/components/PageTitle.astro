---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}

const { title, subtitle, description } = Astro.props;
---

<section
  class="bg-neutral-900 text-white relative overflow-hidden dark:bg-neutral-950"
>
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0"></div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 relative z-10">
    <div class="text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4 mt-5">
        {title}
      </h1>
      {
        subtitle && (
          <p class="text-xl lg:text-2xl text-neutral-200 mb-6">{subtitle}</p>
        )
      }
      {
        description && (
          <p class="text-lg text-neutral-300 max-w-3xl mx-auto">
            {description}
          </p>
        )
      }
    </div>
  </div>
</section>
