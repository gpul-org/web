---
import type { JsonLd } from "../lib/seo";

interface Props {
  data: JsonLd[];
}

const { data } = Astro.props;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": data,
}).replaceAll("<", "\\u003c");
---

<script type="application/ld+json" is:inline set:html={jsonLd}></script>
