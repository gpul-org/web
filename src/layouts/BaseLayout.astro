---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import StructuredData from "../components/StructuredData.astro";
import { canonicalUrl, type JsonLd } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  eventDate?: Date;
  publishedDate?: Date;
  modifiedDate?: Date;
  structuredData?: JsonLd[];
}

const {
  title = "",
  description = "",
  image = "/meta.png",
  eventDate,
  publishedDate,
  modifiedDate,
  structuredData = [],
} = Astro.props;

const siteUrl = new URL(Astro.site ?? Astro.url.origin);
const canonicalURL = canonicalUrl(Astro.url.pathname, siteUrl);
const organizationId = new URL("#organization", siteUrl).href;
const websiteId = new URL("#website", siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
const eventDateIso = eventDate?.toISOString();
const publishedDateIso = publishedDate?.toISOString();
const modifiedDateIso = modifiedDate?.toISOString();

const schemas: JsonLd[] = [
  {
    "@type": "Organization",
    "@id": organizationId,
    name: "Grupo de Programadores e Usuarios de Linux",
    alternateName: "GPUL",
    url: siteUrl.href,
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.svg", siteUrl).href,
    },
    sameAs: [
      "https://mastodon.social/@gpul_",
      "https://bsky.app/profile/gpul.org",
      "https://github.com/gpul-org",
      "https://x.com/gpul_",
    ],
    email: "info@gpul.org",
    telephone: "+34 881 01 1369",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Facultade de Informática, Campus de Elviña s/n",
      addressLocality: "A Coruña",
      addressCountry: "ES",
    },
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: siteUrl.href,
    name: "GPUL",
    description:
      "Asociación universitaria dedicada á promoción do software libre e a tecnoloxía aberta.",
    inLanguage: "gl",
    publisher: { "@id": organizationId },
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalURL.href}#webpage`,
    url: canonicalURL.href,
    name: title,
    description,
    inLanguage: "gl",
    isPartOf: { "@id": websiteId },
    publisher: { "@id": organizationId },
    ...(publishedDateIso ? { datePublished: publishedDateIso } : {}),
    ...(modifiedDateIso ? { dateModified: modifiedDateIso } : {}),
  },
  ...structuredData,
];
---

<!doctype html>
<html lang="gl" class="h-full" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Self-hosted Umami Tracking Code -->
    <script
      is:inline
      defer
      data-astro-rerun
      src="https://umami.gpul.org/script.js"
      data-website-id="a9895841-f600-4828-924a-4f15ef96c429"></script>

    <!-- Sitemap Plugin Integration -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Meta Tags Generated with https://metatags.io -->
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {eventDateIso && <meta name="date" content={eventDateIso} />}
    {publishedDateIso && <meta name="publish_date" content={publishedDateIso} />}
    {publishedDateIso && <meta property="article:published_time" content={publishedDateIso} />}
    {modifiedDateIso && <meta property="article:modified_time" content={modifiedDateIso} />}
    {modifiedDateIso && <meta property="og:updated_time" content={modifiedDateIso} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />

    <StructuredData data={schemas} />

    <!-- View Transitions -->
    <ClientRouter fallback="animate" />

    <script is:inline>
      document.addEventListener("astro:before-preparation", (event) => {
        event.direction = event.sourceElement?.closest("nav")
          ? "navigation"
          : "content";
      });
    </script>
  </head>
  <body class="h-full bg-white dark:bg-neutral-900">
    <slot />
  </body>
</html>
